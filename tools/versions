# Pinned versions of the tools OpenTRAP bundles or vendors, and the sha256 of
# every artifact the fetch recipes download. This is the single source of
# truth: the fetch recipes in the justfile install exactly these bytes, and
# `just check-updates` compares versions with upstream. Bump a version and its
# hash together as part of a release, then re-run the matching fetch recipe.

CHROMIUM_REVISION=1725220
# Google's snapshot storage publishes no sha256, so these are the hashes of the
# pinned revision's archives, recorded when they were fetched. `just browser`
# refuses an archive that does not match.
CHROMIUM_CHROME_SHA256=b33932ab6f6cfbc6b8c666cb6812ebd3090f3a39776d9444e3164ae7e0e07c17
CHROMIUM_DRIVER_SHA256=7cd2d78d706d76fb62de981d0d8d7590bc039fdbac46847520cf4d41427aaec3
BOUNCYCASTLE_VERSION=1.78.1
BROTLI_DEC_VERSION=0.1.2
# sha256 of the jars vendored in lib/ (bcprov, bcpkix and bcutil at
# BOUNCYCASTLE_VERSION, dec at BROTLI_DEC_VERSION), the same bytes Maven
# Central serves. Every build refuses a lib/ that holds other jars or other
# bytes.
BOUNCYCASTLE_PROV_SHA256=add5915e6acfc6ab5836e1fd8a5e21c6488536a8c1f21f386eeb3bf280b702d7
BOUNCYCASTLE_PKIX_SHA256=4b48ea084e5232b9d79ebca1887b9de037b124931807cd60710748c2aee08cc9
BOUNCYCASTLE_UTIL_SHA256=d9fa56f97b0f761ce3bc8d9d74c5d7137a987bf5bd3abfe1003f9bafa45a1d2f
BROTLI_DEC_SHA256=615c0c3efef990d77831104475fba6a1f7971388691d4bad1471ad84101f6d52

# OWASP ZAP engine (crawl + active scan backend, run headless)
ZAP_VERSION=2.17.0
ZAP_SHA256=0cb73b7f72d12c263fb61de304edb82a455d7aa4e1813c216c061765c306f5b7

# The ZAP add-ons are not pinned here: 'just engine' installs the newest
# version of each that ZAP publishes for ZAP_VERSION (ZapVersions-<major.minor>.xml),
# checked against the sha256 in that list, the same as 'just addons update'.

# Java language and API level the code is written against. Every build recipe
# compiles with --release $JAVA_RELEASE, so any JDK from this version up builds
# OpenTRAP, and the code cannot use a newer API by accident. The runtime the
# AppImage ships (JDK_VERSION below) may be newer than this, never older.
JAVA_RELEASE=27

# Portable JDK used to compile OpenTRAP and build the AppImage runtime.
# Temurin is built on an old glibc, so the AppImage runs on mainstream Linux.
# The full release (not just the major) is pinned, plus the sha256 of the
# tarball for each Linux architecture an AppImage is built for, so every
# machine fetches the same bytes.
JDK_VERSION=27.0.1.1+4
JDK_LINUX_X64_SHA256=005e57ee860978acfeeff1be2b30f770664fe2b941e9b803c61c76992086d107
JDK_LINUX_AARCH64_SHA256=fc6986815165fc9506eb6a01ace00942f5c91c993102355ab01cea3e2de9736d

# appimagetool packs the release AppImage. Pinned by version and hash, per
# architecture, because the packaging recipe executes it.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_X64_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGETOOL_AARCH64_SHA256=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158

# just runs every build, test, fetch and packaging recipe (justfile). CI
# installs this release of the x86_64 Linux build and checks its sha256;
# locally any just from this version up works.
JUST_VERSION=1.59.0
JUST_LINUX_X64_SHA256=409044617b6f06517c1035e55ca38c8c856ff8b650e41bc2aa1ef82d5903a23e

format = 1
name = Light
appearance = light

# constants: the main colours and numbers

@page = #FFFFFF
@surface = #EEEEEE
@text = #1A1A1A
@muted = #6B6B6B
@border = #D4D4D4
@accent = #BC5328
@control = #26639C
@link = #1A5FB4
@ok = #3A9A4B
@warn = #E8820C
@error = #CC0000
@radius = 6

# keys

BG = @page
SURFACE = @surface
SURFACE_2 = darker(@surface, 4%)
SURFACE_3 = darker(@surface, 9%)
BORDER = @border
TEXT = @text
MUTED = @muted
LINK = @link
ACCENT = @accent
ACCENT_DARK = darker(@accent, 14%)
ACCENT_TEXT = darker(@accent, 18%)
ACCENT_LIGHT = mix(@link, @page, 22%)
CONTROL = @control
CONTROL_TINT = lighter(@control, 90%)
SEGMENT_OFF = darker(@page, 12.5%)
TAB_TEXT = lighter(@text, 7%)
TAB_TEXT_ON = #000000
ACCENT_FAINT = darker(@page, 3%)
CARD = @page
HEADER = darker(@page, 5%)
ICON = lighter(@text, 26%)
TOGGLE_OFF = #B8BCC2
SCROLL_THUMB = #C9CFD6
SCROLL_THUMB_HOVER = #B4BBC4
OK = @ok
HIGHLIGHT = #FFF176
CODE_NAME = #33338D
CODE_START = #8A1F1F
CODE_KEY = #9A4A0A
CODE_STRING = #17732F
CODE_NUMBER = #0B7285
HEX_OFFSET = lighter(@text, 48%)
HEX_ASCII = #335588
DIFF_DELETED = mix(@error, @page, 20%)
DIFF_ADDED = mix(@ok, @page, 26%)
DIFF_MODIFIED = mix(@link, @page, 22%)
ERROR = @error
WARN = #E08A1E
DIALOG_ERROR = #D33C3C
SEVERITY_HIGH = #D51F3D
SEVERITY_MEDIUM = darker(@warn, 8%)
SEVERITY_LOW = #5C9ACF
SEVERITY_INFO = lighter(@text, 48%)
ADVISORY_HIGH = #C4383D
ADVISORY_MEDIUM = #7E57C2
ADVISORY_LOW = #3B68B5
ADVISORY_INFO = lighter(@text, 35%)
TEXT_ON_ACCENT = @page
TEXT_ON_CONTROL = @page
TEXT_ON_SELECTION = @text
TEXT_ON_BADGE = #FFFFFF
TEXT_ON_BADGE_DARK = #000000
SITE_INSECURE = #D51F3D
SITE_FOLDER = #E8A23B
SITE_FOLDER_LIGHT = #F4C26B
SITE_OVERLAY = #FFFFFF
SITE_PAGE = #FFFFFF
EMPTY_ICON = #5C9ACF
DECODE_URL = #E03C3C
DECODE_HTML = @warn
DECODE_BASE64 = #D4C200
DECODE_HEX = #2EA04A
DECODE_OCTAL = #1F9EA8
DECODE_BINARY = #C03CC0
DECODE_COMPRESSED = #E07A7A
HERO_TOP = #16182E
HERO_BOTTOM = #0E1020
HERO_GLOW = @accent
HERO_TEXT = #FFFFFF
HERO_ACCENT = @accent
HERO_BODY = #E6E6EA
HERO_MUTED = #B0B4C0
INTERCEPT_BEAM = #D0D4DA
INTERCEPT_BODY = #2D5BA6
INTERCEPT_FACE = #BFD4EE
INTERCEPT_LAMP_OFF = #8EA6C8
INTERCEPT_LAMP_ON = #3FB04E
HIGHLIGHT_RED = #FF6B6B
HIGHLIGHT_ORANGE = #FFA94D
HIGHLIGHT_YELLOW = #FFE066
HIGHLIGHT_GREEN = #8CE99A
HIGHLIGHT_CYAN = #66D9E8
HIGHLIGHT_BLUE = #74C0FC
HIGHLIGHT_PINK = #FAA2C1
HIGHLIGHT_MAGENTA = #E599F7
HIGHLIGHT_GREY = #CED4DA
COMPARE_TAKEN = #A8AEB8
POSITION_MARK = #FFE2B3
RADIUS = @radius
CARD_RADIUS = @radius + 2
TAB_HOVER_RADIUS = @radius + 2
LINE_WIDTH = 1

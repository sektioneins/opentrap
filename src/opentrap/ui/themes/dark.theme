format = 1
name = Dark
appearance = dark

# constants: the main colours and numbers

@page = #252525
@surface = #2C2C2C
@text = #DEDEDE
@muted = #9C9C9C
@border = #404040
@accent = #DB612F
@control = #5593D0
@link = #6CA6F0
@ok = #5CC46E
@warn = #E8820C
@error = #CC0000
@radius = 6

# keys

BG = @page
SURFACE = @surface
SURFACE_2 = lighter(@surface, 6.5%)
SURFACE_3 = lighter(@surface, 14%)
BORDER = @border
TEXT = @text
MUTED = @muted
LINK = @link
ACCENT = @accent
ACCENT_DARK = lighter(@accent, 8%)
ACCENT_LIGHT = mix(@control, @page, 26%)
CONTROL = @control
CONTROL_TINT = #1E2A36
SEGMENT_OFF = lighter(@surface, 6.5%)
TAB_TEXT = darker(@text, 7%)
TAB_TEXT_ON = #FFFFFF
ACCENT_FAINT = darker(@surface, 3%)
CARD = lighter(@page, 5%)
HEADER = lighter(@surface, 6.5%)
ICON = darker(@text, 19%)
TOGGLE_OFF = #555A62
SCROLL_THUMB = #4E545C
SCROLL_THUMB_HOVER = #626972
OK = @ok
HIGHLIGHT = #745A00

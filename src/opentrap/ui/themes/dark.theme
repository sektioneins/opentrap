SEVERITY_LOW = #5C9ACF
SEVERITY_INFO = darker(@muted, 13%)
ADVISORY_HIGH = #E0474C
ADVISORY_MEDIUM = #7E57C2
ADVISORY_LOW = #4477CC
ADVISORY_INFO = darker(@muted, 13%)
TEXT_ON_ACCENT = darker(@page, 30%)
TEXT_ON_CONTROL = darker(@page, 30%)
TEXT_ON_SELECTION = #FFFFFF
TEXT_ON_BADGE = #FFFFFF
SITE_INSECURE = #D51F3D
SITE_FOLDER = #E8A23B
SITE_FOLDER_LIGHT = #F4C26B
SITE_OVERLAY = #FFFFFF
SITE_PAGE = #FFFFFF
EMPTY_ICON = #5C9ACF
DECODE_URL = #E03C3C
DECODE_HTML = @warn
DECODE_BASE64 = #D4C200
DECODE_HEX = #2EA04A
DECODE_OCTAL = #1F9EA8
